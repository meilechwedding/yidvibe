{
  "name": "yidvibe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "theme:sync": "node scripts/sync-theme.mjs",
    "theme:check": "node scripts/sync-theme.mjs --check",
    "predev": "npm run theme:sync",
    "prebuild": "npm run theme:sync",
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:frontend": "vitest run --exclude tests/security-regressions.test.ts",
    "test:boundaries": "vitest run tests/security-regressions.test.ts -t \"redirect boundaries|server-side request boundaries|image URL boundaries|repository hygiene|a competition can only select one of its own submissions\"",
    "test:eligible": "npm run test:frontend && npm run test:boundaries",
    "review:coverage": "node scripts/review-coverage.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.48.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "nanoid": "^5.1.11",
    "next": "^15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.55.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.5"
  }
}
